# === SAGE125 LINE ENDING RULES ===
* text=auto

# Source and configuration files use LF
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.svg text eol=lf
docs/modules/T05/**/*.log binary

# Windows scripts use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.7z binary
*.db binary
*.sqlite binary
*.parquet binary
*.pkl binary
*.pickle binary
*.onnx binary
*.pt binary
*.pth binary
# === END SAGE125 LINE ENDING RULES ===
