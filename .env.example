# ============================================================
# SAGE125-AI-Scientist 环境变量示例（.env.example）
# 用途：作为 .env 的模板，可安全提交到仓库。
# 注意：本文件不得包含任何真实 API Key。
#      真实 Key 请运行 `python scripts/setup_env.py` 在本地终端输入。
# ============================================================

# ===== 阿里云百炼 / DashScope =====
DASHSCOPE_API_KEY=
WORKSPACE_ID=
DASHSCOPE_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===== Qwen 聊天模型 =====
QWEN_FAST_MODEL=qwen3.6-flash
QWEN_BALANCED_MODEL=qwen3.7-plus
QWEN_STRONG_MODEL=qwen3.7-max

# ===== Qwen Deep Research =====
QWEN_DEEP_RESEARCH_MODEL=qwen-deep-research
DASHSCOPE_DEEP_RESEARCH_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api/v1

# ===== 调用稳定性（流式、有限重试、快速连通性检查）=====
LLM_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=8192
QWEN_PROBE_TIMEOUT_SECONDS=20
DEEP_RESEARCH_TIMEOUT_SECONDS=900

# 可选：当本机/VPN 无法直连阿里云 HTTPS 时配置；可能含凭证，严禁提交。
OUTBOUND_HTTPS_PROXY=

# ===== RAG：百炼向量与重排序 =====
EMBEDDING_BACKEND=bailian
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_RERANK_MODEL=qwen3-rerank

# ===== 可选：本地 Qwen3 Embedding / Reranker，默认不启用 =====
LOCAL_QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_QWEN_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ===== 文献 API =====
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_REQUEST_INTERVAL_SECONDS=3

OPENALEX_API_KEY=

CROSSREF_BASE_URL=https://api.crossref.org
CONTACT_EMAIL=

# ===== 应用配置 =====
APP_ENV=development
EXPORT_DIR=exports
DATA_DIR=data
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
MAX_UPLOAD_MB=25
# 永久本地文献库容量治理（HTTP 与 Streamlit fallback 共用）
LIBRARY_MAX_BATCH_FILES=10
LIBRARY_MAX_BATCH_MB=100
LIBRARY_MAX_FILES=500
LIBRARY_MAX_RAW_MB=2048
LIBRARY_MAX_INDEX_MB=4096
LIBRARY_MAX_CHUNKS=100000
LIBRARY_MAX_CHUNKS_PER_FILE=5000
LIBRARY_MAX_PDF_PAGES=2000
LIBRARY_MAX_TEXT_CHARS=10000000
LIBRARY_MAX_CSV_ROWS=250000
LIBRARY_MAX_CSV_COLUMNS=200
# 低于该可用空间时拒绝新增文献，避免服务器磁盘被占满
LIBRARY_MIN_FREE_MB=5120
LIBRARY_MIN_FREE_PERCENT=5

# 前端默认进程内运行以实时显示阶段进度；设为 1 才改走本地 FastAPI。
FRONTEND_RUN_VIA_API=0
FRONTEND_API_BASE_URL=http://127.0.0.1:8000
